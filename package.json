{
	"name": "hartazone-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "React + TypeScript frontend template: Vite, TanStack Router & Query, Tailwind CSS v4, shadcn/ui, React Hook Form + Zod and a typed OpenAPI client.",
	"packageManager": "pnpm@11.0.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc --noEmit",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
		"generate:api": "openapi-typescript ./openapi/schema.json --output ./src/shared/client/api-types.d.ts && orval",
		"new:feature": "node ./scripts/new-feature.mjs",
		"postinstall": "pnpm generate:api",
		"predev": "pnpm generate:api",
		"prebuild": "pnpm generate:api",
		"pretypecheck": "pnpm generate:api",
		"pretest": "pnpm generate:api"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.10",
		"fetch-retry": "^6.0.0",
		"lucide-react": "^1.37.0",
		"neverthrow": "8.2.0",
		"openapi-fetch": "^0.17.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.107.1",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-plugin": "^1.168.35",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"openapi-typescript": "^7.13.0",
		"orval": "^8.48.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.3"
	}
}
